# Copy to .env and fill in local values. Never commit .env.

# --- Database ---
DATABASE_URL="postgresql://vsa:vsa@localhost:5432/vsa?schema=public"

# --- API server ---
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --- Staff auth (Entra ID / OIDC) ---
# In production these come from Entra ID; in dev we use a symmetric HS256 secret.
JWT_ISSUER="https://login.microsoftonline.com/DEV_TENANT/v2.0"
JWT_AUDIENCE="api://vsa-dev"
JWT_DEV_SECRET="dev-only-symmetric-secret-change-me-min-32-chars"

# --- Vendor invite tokens ---
# Server-side pepper used to HMAC vendor tokens before storage/lookup.
# MUST be a high-entropy secret; rotate via envelope re-hashing (out of scope for Sprint 1).
VENDOR_TOKEN_PEPPER="dev-only-pepper-change-me-min-32-chars-abcdef"

# --- CORS ---
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# --- Evidence storage (Sprint 2) ---
# Local filesystem adapter for dev. Sprint 7 swaps to Azure Blob via
# `EVIDENCE_STORAGE=azure_blob` and connection settings from Key Vault.
EVIDENCE_STORAGE=local
EVIDENCE_LOCAL_ROOT=./.storage/evidence
EVIDENCE_MAX_BYTES=26214400  # 25 MiB
