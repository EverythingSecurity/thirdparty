    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.2.0",
    "@fastify/sensible": "^5.5.0",
    "@prisma/client": "^5.11.0",
    "@vsa/db": "*",
    "@vsa/shared": "*",
    "fastify": "^4.26.0",
    "fastify-plugin": "^4.5.1",
    "jose": "^5.2.0",
    "pino": "^8.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
