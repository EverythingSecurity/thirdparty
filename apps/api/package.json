{
  "name": "@vsa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:tokens": "tsx scripts/dev-tokens.ts",
    "start": "node dist/index.js",
