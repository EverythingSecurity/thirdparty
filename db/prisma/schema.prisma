// VSA Platform database schema.
// Source of truth: SOLUTION_BLUEPRINT.md §3.
// CHECK constraints, audit_log grants, and RLS live in the raw SQL migration
// (Prisma cannot express those declaratively).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Alpine + openssl3 for Azure Container Apps images; native for macOS/Linux dev.
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext]
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  admin
  cyber_reviewer
  legal_reviewer
  risk_manager

  @@map("user_role")
}

enum ResponseValue {
  compliant
  non_compliant
  not_applicable

  @@map("response_value")
}

enum ControlSource {
  scf
  custom

  @@map("control_source")
}

enum AssessmentStatus {
  draft
  sent
  in_progress
  submitted
  in_review
  escalated
  approved
  conditional
  rejected

  @@map("assessment_status")
}

enum ReviewerAction {
  accept
  edit
  override

  @@map("reviewer_action")
}

enum ReviewDecisionValue {
  approve
  request_info
  escalate
  reject

  @@map("review_decision_value")
}

enum DispositionValue {
  approve
  conditional
  reject

  @@map("disposition_value")
}

enum AiGenerationKind {
  summary
  gap_analysis
  remediation
  briefing
  cross_domain_note

  @@map("ai_generation_kind")
}

enum CriticalityTier {
  low
  medium
  high
  critical

  @@map("criticality_tier")
}

// ============================================================
// ORGANIZATIONS & USERS
// ============================================================

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users              User[]
  vendors            Vendor[]
  controlDomains     ControlDomain[]
  controls           Control[]
  questions          Question[]
  checklistTemplates ChecklistTemplate[]
  assessments        Assessment[]
  auditLogs          AuditLog[]

  @@map("organizations")
}

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  email          String   @db.Citext
  fullName       String   @map("full_name")
  role           UserRole
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendorInvitesIssued VendorInvite[]        @relation("VendorInviteIssuer")
  weightHistories    ControlWeightHistory[]
  assessmentsAssigned Assessment[]          @relation("AssessmentAssignedBy")
  reviewerVerdicts   ReviewerVerdict[]
  reviewDecisions    ReviewDecision[]
  dispositions       Disposition[]
  auditLogs          AuditLog[]

  @@unique([organizationId, email])
  @@index([organizationId, role], map: "idx_users_org_role")
  @@map("users")
}

// ============================================================
// VENDORS & TOKEN-BASED INVITES
// ============================================================

model Vendor {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  name                String
  primaryContactEmail String?           @map("primary_contact_email") @db.Citext
  criticalityTier     CriticalityTier?  @map("criticality_tier")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessments  Assessment[]

  @@index([organizationId], map: "idx_vendors_org")
  @@map("vendors")
}

model VendorInvite {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId     String    @map("vendor_id") @db.Uuid
  assessmentId String    @map("assessment_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  issuedById   String?   @map("issued_by") @db.Uuid
  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  redeemedAt   DateTime? @map("redeemed_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  issuedBy   User?      @relation("VendorInviteIssuer", fields: [issuedById], references: [id])
  auditLogs  AuditLog[]

  @@index([expiresAt], map: "idx_invites_expiry")
  @@map("vendor_invites")
}

// ============================================================
// CONTROL LIBRARY
// ============================================================

model ControlDomain {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String
  sortOrder      Int    @default(0) @map("sort_order")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  controls         Control[]
  riskDomainScores RiskDomainScore[]

  @@unique([organizationId, name])
  @@map("control_domains")
}

model Control {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  controlDomainId String        @map("control_domain_id") @db.Uuid
  controlCode     String        @map("control_code")
  title           String
  description     String?
  source          ControlSource @default(scf)
  frameworkRef    String?       @map("framework_ref")
  currentWeight   Int           @map("current_weight") @db.SmallInt
  isDeprecated    Boolean       @default(false) @map("is_deprecated")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  controlDomain   ControlDomain          @relation(fields: [controlDomainId], references: [id])
  weightHistories ControlWeightHistory[]
  routingRules    RoutingRule[]
  questions       Question[]
  responses       Response[]
  aiGenerations   AiGeneration[]
  verdicts        ReviewerVerdict[]

  @@unique([organizationId, controlCode])
  @@index([controlDomainId], map: "idx_controls_domain")
  @@map("controls")
}

model ControlWeightHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  controlId String   @map("control_id") @db.Uuid
  weight    Int      @db.SmallInt
  changedById String @map("changed_by") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  reason    String?

  control   Control @relation(fields: [controlId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedById], references: [id])

  @@index([controlId, changedAt], map: "idx_weight_history_control")
  @@map("control_weight_history")
}

model RoutingRule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  controlId String   @map("control_id") @db.Uuid
  role      UserRole

  control Control @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@unique([controlId, role])
  @@map("routing_rules")
}

// ============================================================
// QUESTION BANK & CHECKLIST TEMPLATES
// ============================================================

model Question {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  controlId        String   @map("control_id") @db.Uuid
  questionText     String   @map("question_text")
  helpText         String?  @map("help_text")
  requiresEvidence Boolean  @default(false) @map("requires_evidence")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  control            Control                     @relation(fields: [controlId], references: [id])
  templateQuestions  ChecklistTemplateQuestion[]
  responses          Response[]

  @@index([controlId], map: "idx_questions_control")
  @@map("questions")
}

model ChecklistTemplate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  version        Int      @default(1)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateQuestions ChecklistTemplateQuestion[]
  assessments       Assessment[]

  @@map("checklist_templates")
}

model ChecklistTemplateQuestion {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checklistTemplateId String @map("checklist_template_id") @db.Uuid
  questionId          String @map("question_id") @db.Uuid
  sortOrder           Int    @default(0) @map("sort_order")

  checklistTemplate ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)
  question          Question          @relation(fields: [questionId], references: [id])

  @@unique([checklistTemplateId, questionId])
  @@map("checklist_template_questions")
}

// ============================================================
// ASSESSMENTS
// ============================================================

model Assessment {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  vendorId            String           @map("vendor_id") @db.Uuid
  checklistTemplateId String           @map("checklist_template_id") @db.Uuid
  status              AssessmentStatus @default(draft)
  assignedById        String?          @map("assigned_by") @db.Uuid
  assignedAt          DateTime?        @map("assigned_at") @db.Timestamptz(6)
  submittedAt         DateTime?        @map("submitted_at") @db.Timestamptz(6)
  submissionHash      String?          @map("submission_hash")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor            Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  checklistTemplate ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id])
  assignedBy        User?             @relation("AssessmentAssignedBy", fields: [assignedById], references: [id])
  vendorInvites     VendorInvite[]
  responses         Response[]
  aiGenerations     AiGeneration[]
  verdicts          ReviewerVerdict[]
  reviewDecisions   ReviewDecision[]
  riskScores        RiskScore[]
  disposition       Disposition?

  @@index([vendorId], map: "idx_assessments_vendor")
  @@index([organizationId, status], map: "idx_assessments_status")
  @@map("assessments")
}

// ============================================================
// RESPONSES & EVIDENCE
// ============================================================

model Response {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId     String         @map("assessment_id") @db.Uuid
  questionId       String         @map("question_id") @db.Uuid
  controlId        String         @map("control_id") @db.Uuid
  weightAtResponse Int            @map("weight_at_response") @db.SmallInt
  responseValue    ResponseValue? @map("response_value")
  justification    String?
  isLocked         Boolean        @default(false) @map("is_locked")
  respondedAt      DateTime?      @map("responded_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assessment    Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question      Question       @relation(fields: [questionId], references: [id])
  control       Control        @relation(fields: [controlId], references: [id])
  evidenceFiles EvidenceFile[]

  @@unique([assessmentId, questionId])
  @@index([assessmentId], map: "idx_responses_assessment")
  @@index([controlId], map: "idx_responses_control")
  @@map("responses")
}

model EvidenceFile {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responseId    String    @map("response_id") @db.Uuid
  fileName      String    @map("file_name")
  fileSizeBytes BigInt    @map("file_size_bytes")
  mimeType      String    @map("mime_type")
  storageUri    String    @map("storage_uri")
  uploadedAt    DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  response Response @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId], map: "idx_evidence_response")
  @@map("evidence_files")
}

// ============================================================
// AI GENERATIONS
// ============================================================

model AiGeneration {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId    String           @map("assessment_id") @db.Uuid
  controlId       String?          @map("control_id") @db.Uuid
  controlDomainId String?          @map("control_domain_id") @db.Uuid
  kind            AiGenerationKind
  modelName       String           @map("model_name")
  prompt          Json             @db.JsonB
  responseText    String           @map("response_text")
  generatedAt     DateTime         @default(now()) @map("generated_at") @db.Timestamptz(6)
  isStale         Boolean          @default(false) @map("is_stale")
  supersededById  String?          @map("superseded_by") @db.Uuid

  assessment   Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  control      Control?          @relation(fields: [controlId], references: [id])
  supersededBy AiGeneration?     @relation("AiGenerationSupersession", fields: [supersededById], references: [id])
  supersedes   AiGeneration[]    @relation("AiGenerationSupersession")
  verdicts     ReviewerVerdict[]

  @@index([assessmentId, kind], map: "idx_ai_gen_assessment")
  @@map("ai_generations")
}

// ============================================================
// REVIEWER VERDICTS & DECISIONS
// ============================================================

model ReviewerVerdict {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId   String         @map("assessment_id") @db.Uuid
  controlId      String         @map("control_id") @db.Uuid
  reviewerId     String         @map("reviewer_id") @db.Uuid
  aiGenerationId String?        @map("ai_generation_id") @db.Uuid
  action         ReviewerAction
  finalText      String?        @map("final_text")
  comment        String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  assessment   Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  control      Control       @relation(fields: [controlId], references: [id])
  reviewer     User          @relation(fields: [reviewerId], references: [id])
  aiGeneration AiGeneration? @relation(fields: [aiGenerationId], references: [id])

  @@unique([assessmentId, controlId, reviewerId])
  @@index([assessmentId], map: "idx_verdicts_assessment")
  @@map("reviewer_verdicts")
}

model ReviewDecision {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId String              @map("assessment_id") @db.Uuid
  reviewerId   String              @map("reviewer_id") @db.Uuid
  reviewerRole UserRole            @map("reviewer_role")
  decision     ReviewDecisionValue
  comment      String?
  decidedAt    DateTime            @default(now()) @map("decided_at") @db.Timestamptz(6)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  reviewer   User       @relation(fields: [reviewerId], references: [id])

  @@unique([assessmentId, reviewerRole])
  @@map("review_decisions")
}

// ============================================================
// RISK SCORES
// ============================================================

model RiskScore {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId   String          @map("assessment_id") @db.Uuid
  aggregateScore Decimal         @map("aggregate_score") @db.Decimal(5, 2)
  tier           CriticalityTier
  isFinal        Boolean         @default(false) @map("is_final")
  computedAt     DateTime        @default(now()) @map("computed_at") @db.Timestamptz(6)

  assessment   Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  domainScores RiskDomainScore[]

  @@index([assessmentId, isFinal], map: "idx_risk_scores_assessment")
  @@map("risk_scores")
}

model RiskDomainScore {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  riskScoreId     String   @map("risk_score_id") @db.Uuid
  controlDomainId String   @map("control_domain_id") @db.Uuid
  subScore        Decimal  @map("sub_score") @db.Decimal(5, 2)
  contributionPct Decimal? @map("contribution_pct") @db.Decimal(5, 2)

  riskScore     RiskScore     @relation(fields: [riskScoreId], references: [id], onDelete: Cascade)
  controlDomain ControlDomain @relation(fields: [controlDomainId], references: [id])

  @@unique([riskScoreId, controlDomainId])
  @@map("risk_domain_scores")
}

// ============================================================
// DISPOSITION
// ============================================================

model Disposition {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId  String           @unique @map("assessment_id") @db.Uuid
  riskManagerId String           @map("risk_manager_id") @db.Uuid
  decision      DispositionValue
  comment       String?
  decidedAt     DateTime         @default(now()) @map("decided_at") @db.Timestamptz(6)

  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  riskManager User       @relation(fields: [riskManagerId], references: [id])

  @@map("dispositions")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id                  BigInt   @id @default(autoincrement())
  organizationId      String   @map("organization_id") @db.Uuid
  actorUserId         String?  @map("actor_user_id") @db.Uuid
  actorVendorInviteId String?  @map("actor_vendor_invite_id") @db.Uuid
  action              String
  entityType          String   @map("entity_type")
  entityId            String?  @map("entity_id") @db.Uuid
  beforeValue         Json?    @map("before_value") @db.JsonB
  afterValue          Json?    @map("after_value") @db.JsonB
  occurredAt          DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organization       Organization  @relation(fields: [organizationId], references: [id])
  actorUser          User?         @relation(fields: [actorUserId], references: [id])
  actorVendorInvite  VendorInvite? @relation(fields: [actorVendorInviteId], references: [id])

  @@index([organizationId, occurredAt(sort: Desc)], map: "idx_audit_org_time")
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@map("audit_log")
}
