{
  "name": "@vsa/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev && npm run post-migrate",
    "migrate:deploy": "prisma migrate deploy && npm run post-migrate",
    "post-migrate": "prisma db execute --file prisma/post-migrate.sql --schema prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.11.0"
  },
  "devDependencies": {
    "prisma": "^5.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
